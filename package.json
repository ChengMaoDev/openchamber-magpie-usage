{
  "name": "openchamber-magpie-usage",
  "version": "0.2.4",
  "description": "Community OpenChamber extension for local Magpie quotas, tokens and estimated costs",
  "license": "MIT",
  "author": "ChengMaoDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChengMaoDev/openchamber-magpie-usage.git"
  },
  "bugs": {
    "url": "https://github.com/ChengMaoDev/openchamber-magpie-usage/issues"
  },
  "homepage": "https://github.com/ChengMaoDev/openchamber-magpie-usage#readme",
  "keywords": [
    "openchamber",
    "magpie",
    "extension",
    "usage",
    "quota"
  ],
  "files": [
    "panel/",
    "service/",
    "icon.svg",
    "docs/panel-light.png",
    "docs/panel-dark.png",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run check && bun run lint && bun test && bun run build && bun scripts/verify-manifest.ts",
    "format": "biome check --write src scripts tests package.json tsconfig.json",
    "lint": "biome check src scripts tests package.json tsconfig.json",
    "package": "bun run build && bun scripts/package.ts"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.0",
    "zod": "4.3.6",
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "magpie-usage",
        "name": "Magpie Usage",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "statusSection": {
        "entry": "panel/index.html",
        "title": "Magpie",
        "height": 240
      },
      "service": {
        "entry": "service/main.cjs",
        "runtime": "host"
      }
    }
  }
}
